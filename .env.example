# DeepSeek uses an OpenAI-compatible Chat Completions API.
# This label is only shown in the UI; it does not change the API protocol.
MODEL_PROVIDER=DeepSeek
# Never put this key in VITE_ variables, browser code, localStorage or commits.
MODEL_API_KEY=
# DeepSeek official API endpoint. The server appends /chat/completions.
MODEL_BASE_URL=https://api.deepseek.com
# Direct DeepSeek model identifier. Confirm availability for your account before use.
MODEL_NAME=deepseek-v4-pro
# Optional bounded wait budgets, in milliseconds (1000..300000); restart the server after changes.
# A longer budget improves availability for slow responses; it does not make the model faster.
MODEL_COACH_TIMEOUT_MS=150000
MODEL_INTERVIEW_TIMEOUT_MS=60000

# Local-only model usage monitoring. The JSONL log never stores prompts, resumes, JD text, answers or API keys.
LLM_USAGE_LOG_PATH=.local-usage/llm-usage.jsonl
# Set true only after confirming the selected provider/model pricing. Protection is global to this local server, not per user.
LLM_BUDGET_ENFORCEMENT=false
LLM_DAILY_BUDGET_CNY=1
LLM_MONTHLY_BUDGET_CNY=20
LLM_DAILY_REQUEST_LIMIT=30
# This cap is sent as max_tokens. 16384 preserves the existing long coach-response budget better than a small default.
LLM_MAX_OUTPUT_TOKENS=16384
# Default is intentionally zero: retrying a request after a lost network response can create an extra paid request.
LLM_MAX_RETRIES=0
# Actual-usage estimation uses Asia/Shanghai weekdays/windows and the bundled 2026 public-holiday calendar.
# Request budgets ALWAYS reserve at the peak upper bound. auto is recommended;
# peak/off_peak are explicit manual tariff overrides and are labelled in logs/reports.
# A future year with no holiday calendar reports possible peak hours as unknown, not falsely exact.
LLM_DEEPSEEK_PRICING_MODE=auto
# Optional manual rates for compatible providers or account-specific prices, in CNY per 1M tokens.
# LLM_INPUT_CNY_PER_M_TOKEN=
# LLM_CACHE_HIT_CNY_PER_M_TOKEN=
# LLM_OUTPUT_CNY_PER_M_TOKEN=
